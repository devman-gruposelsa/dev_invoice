<odoo noupdate="1">
    <record id="cron_storage_invoice" model="ir.cron">
        <field name="name">Generar facturas mensuales automáticas</field>
        <field name="model_id" ref="model_project_task"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_monthly_invoices()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">False</field>
        <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 06:00:00')"/>
    </record>
</odoo>